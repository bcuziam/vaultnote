{
  "name": "VaultNote — 초경량 보안 & 지식관리 노트",
  "short_name": "VaultNote",
  "description": "노션 블록 에디터 + 옵시디언 양방향 링크 + AES-256 보안 금고 + 원드라이브/구글드라이브 동기화",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#0f1117",
  "theme_color": "#6366f1",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "clip_title",
      "text": "clip_text",
      "url": "clip_url"
    }
  }
}
